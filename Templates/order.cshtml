
@using OrdersApi.Dtos 
 @model OrderDto
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>order</title>

    <!-- Bootstrap 5 -->
    <link 
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" 
        rel="stylesheet"
    >
</head>

<body class="bg-light">
 <div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <form onsubmit="alert('Form submitted!')"  class="p-4 bg-white shadow-sm rounded">

                <h4 class="mb-4 text-center">@Model.OrderId</h4>

                <div class="mb-3">
                    <label class="form-label fw-semibold">version:</label>
                    <input type="text" class="form-control" value="@Model.OrderDate" placeholder="Enter name I GOT NUTHINx">
                </div>

                
                <button type="submit" class="btn btn-primary w-100">
                    Submit
                </button>
            </form>
        </div>
    </div>
</div>
</body>
</html>